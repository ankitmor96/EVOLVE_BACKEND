// use prisma-8
enum SkillRelationshipType {
  CAN_DO
  LEARNING
  WANT_TO_IMPROVE
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  MIXED
  POLL
}

enum PostKind {
  GENERAL
  QUESTION
  PROJECT
  TUTORIAL
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REVIEW
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}


enum NotificationType {
  POST_CREATED
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE_RECEIVED
  COMMENT_CREATED
}


enum PostReactionType {
  APPRECIATE
  HELPFUL
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ExplorationContentType {
  VIDEO
  TEXT
  IMAGE
  LONG_FORM
}

// ========================================
// USER
// ========================================
model User {
  id                         Int                       @id @default(autoincrement())
  name                       String?
  email                      String                    @unique
  password                   String?
  googleId                   String?                   @unique
  emailVerified              Boolean                   @default(false)

  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @default(now())

  profile                    UserProfile?
  identities                 UserIdentity[]
  curiosities                UserCuriosity[]
  skills                     UserSkill[]
  posts                      Post[]
  postReactions              PostReaction[]
  postLearning               PostLearning[]
  comments                   Comment[]

  sentConnections            Connection[]              @relation("ConnectionRequester")
  receivedConnections        Connection[]              @relation("ConnectionReceiver")

  conversationsAsParticipant ConversationParticipant[]
  sentMessages               Message[]
  postExplorations           UserPostExploration[]
  skillPoints                UserSkillPoint[]
}

// ========================================
// EMAIL OTP
// ========================================
model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ========================================
// IDENTITY
// ========================================
model IdentityType {
  id             Int            @id @default(autoincrement())
  name           String
  slug           String         @unique
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())

  userIdentities UserIdentity[]
}

model UserIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int
  identityTypeId Int
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityType   IdentityType @relation(fields: [identityTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, identityTypeId])
  @@index([userId])
  @@index([identityTypeId])
}

// ========================================
// USER PROFILE
// ========================================
model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  username    String   @unique
  avatarUrl   String?
  countryCode String
  ageRange    String
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// SKILL CATEGORIES
// ========================================
model SkillCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  skills      Skill[]
}

// ========================================
// SKILLS
// ========================================
model Skill {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())

  category    SkillCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  curiosities UserCuriosity[]
  userSkills  UserSkill[]
  postSkills  PostSkill[]
  userSkillPoints UserSkillPoint[]

  @@index([categoryId])
}

// ========================================
// USER CURIOSITIES
// ========================================
model UserCuriosity {
  id        Int      @id @default(autoincrement())
  userId    Int
  skillId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ========================================
// USER SKILLS
// ========================================
model UserSkill {
  id               Int                   @id @default(autoincrement())
  userId           Int
  skillId          Int
  relationshipType SkillRelationshipType
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now())

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, relationshipType])
  @@index([userId])
  @@index([skillId])
}

// ========================================
// POSTS
// ========================================
model Post {
  id          Int            @id @default(autoincrement())
  userId      Int
  postType    PostType       @default(TEXT)
  postKind    PostKind       @default(GENERAL)
  caption     String?
  visibility  PostVisibility @default(PUBLIC)
  status      PostStatus     @default(DRAFT)
  moderation_status          ModerationStatus @default(PENDING)
  moderationRetryCount       Int              @default(0)
  nextModerationRetryAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
  publishedAt DateTime?
  deletedAt   DateTime?
  moderationResult ModerationResult?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  skills      PostSkill[]
  reactions   PostReaction[]
  learning    PostLearning[]
  comments    Comment[]
  postExplorations UserPostExploration[]

  @@index([userId, createdAt])
  @@index([status, publishedAt])
}


model PostSkill {
  id        Int      @id @default(autoincrement())
  postId    Int
  skillId   Int
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([postId, skillId])
  @@index([postId])
  @@index([skillId])
}


// ========================================
// POST MEDIA
// ========================================
model PostMedia {
  id           Int       @id @default(autoincrement())
  postId       Int
  mediaType    MediaType
  mediaUrl     String
  thumbnailUrl String?
  altText      String?
  position     Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())

  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

// ========================================
// NOTIFICATIONS
// ========================================
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ========================================
// POST REACTIONS
// ========================================
model PostReaction {
  id           Int              @id @default(autoincrement())
  postId       Int
  userId       Int
  reactionType PostReactionType
  createdAt    DateTime         @default(now())

  post         Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, reactionType])
  @@index([userId])
}

// ========================================
// POST LEARNING
// ========================================
model PostLearning {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

// ========================================
// COMMENTS
// ========================================
model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Connection {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())

  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

// ========================================
// CONVERSATION
// ========================================
model Conversation {
  id           Int                       @id @default(autoincrement())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

// ========================================
// CONVERSATION PARTICIPANT
// ========================================
model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ========================================
// MESSAGE
// ========================================
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  deletedAt      DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ModerationResult {
  id                Int              @id @default(autoincrement())
  postId            Int              @unique
  userId            Int
  postType          PostType
  mediaUrl          String
  moderation_status ModerationStatus
  categories        Json?
  reasons           Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now())

  post              Post             @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moderation_status])
}


model UserPostExploration {
  id                       Int                    @id @default(autoincrement())
  userId                   Int
  postId                   Int
  contentType              ExplorationContentType

  totalConsumptionSeconds  Int                    @default(0)
  maxCompletionPercentage  Decimal                @default(0)
  explorationCount         Int                    @default(0)

  firstExploredAt          DateTime               @default(now())
  lastExploredAt           DateTime               @default(now())

  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @default(now())

  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post                     Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([firstExploredAt])
  @@index([userId, firstExploredAt])
}

model UserSkillPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  skillId   Int
  points    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

