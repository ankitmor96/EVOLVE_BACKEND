
 // use prisma-8


enum SkillRelationshipType {
  CAN_DO
  LEARNING
  WANT_TO_IMPROVE
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  MIXED
  POLL
}

enum PostKind {
  GENERAL
  QUESTION
  PROJECT
  TUTORIAL
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model User {
  id             Int      @id @default(autoincrement())
  name           String?
  email          String   @unique
  password       String?  
  googleId       String?  @unique
  emailVerified  Boolean  @default(false)
 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  profile        UserProfile?
  identities     UserIdentity[]
  curiosities    UserCuriosity[]
  skills         UserSkill[]
  posts          Post[]
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ========================================
// IDENTITY
// ========================================

model IdentityType {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  userIdentities UserIdentity[]
}

model UserIdentity {
  id             Int      @id @default(autoincrement())
  userId         Int
  identityTypeId Int
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityType IdentityType @relation(fields: [identityTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, identityTypeId])
  @@index([userId])
  @@index([identityTypeId])
}

// ========================================
// USER PROFILE
// ========================================

model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  username    String   @unique
  avatarUrl   String?
  countryCode String
  ageRange    String
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// SKILL CATEGORIES
// ========================================

model SkillCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  skills Skill[]
}

// ========================================
// SKILLS
// ========================================

model Skill {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  category    SkillCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  curiosities UserCuriosity[]
  userSkills  UserSkill[]

  @@index([categoryId])
}

// ========================================
// USER CURIOSITIES
// ========================================

model UserCuriosity {
  id        Int      @id @default(autoincrement())
  userId    Int
  skillId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ========================================
// USER SKILLS
// ========================================

model UserSkill {
  id               Int                   @id @default(autoincrement())
  userId           Int
  skillId          Int
  relationshipType SkillRelationshipType
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, relationshipType])
  @@index([userId])
  @@index([skillId])
}

// ========================================
// POSTS
// ========================================

model Post {
  id          Int            @id @default(autoincrement())
  userId      Int
  postType    PostType       @default(TEXT)
  postKind    PostKind       @default(GENERAL)
  caption     String?
  visibility  PostVisibility @default(PUBLIC)
  status      PostStatus     @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
  publishedAt DateTime?
  deletedAt   DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media PostMedia[]

  @@index([userId, createdAt])
  @@index([status, publishedAt])
}

// ========================================
// POST MEDIA
// ========================================

model PostMedia {
  id           Int       @id @default(autoincrement())
  postId       Int
  mediaType    MediaType
  mediaUrl     String
  thumbnailUrl String?
  altText      String?
  position     Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}


enum NotificationType {
  POST_CREATED
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
