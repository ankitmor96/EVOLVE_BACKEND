    "execute": [
      {
        "description": "create table \"Post\"",
        "sql": "CREATE TABLE \"public\".\"Post\" (\n  \"caption\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deletedAt\" timestamptz,\n  \"id\" SERIAL NOT NULL,\n  \"postKind\" text DEFAULT 'GENERAL' NOT NULL,\n  \"postType\" text DEFAULT 'TEXT' NOT NULL,\n  \"publishedAt\" timestamptz,\n  \"status\" text DEFAULT 'DRAFT' NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"userId\" int4 NOT NULL,\n  \"visibility\" text DEFAULT 'PUBLIC' NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Post_postKind_check_53244310\" CHECK (\"postKind\" IN ('GENERAL', 'QUESTION', 'PROJECT', 'TUTORIAL')),\n  CONSTRAINT \"Post_postType_check_07bbca23\" CHECK (\"postType\" IN ('TEXT', 'IMAGE', 'VIDEO', 'MIXED', 'POLL')),\n  CONSTRAINT \"Post_status_check_bc64f66b\" CHECK (\"status\" IN ('DRAFT', 'PUBLISHED', 'ARCHIVED')),\n  CONSTRAINT \"Post_visibility_check_7e49735a\" CHECK (\"visibility\" IN ('PUBLIC', 'CONNECTIONS', 'PRIVATE'))\n)",
        "params": []
      }
    ],
    "postcheck": [
