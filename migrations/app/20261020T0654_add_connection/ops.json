        "sql": "CREATE TABLE \"public\".\"Connection\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"receiverId\" int4 NOT NULL,\n  \"requesterId\" int4 NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Connection_status_check_904c6455\" CHECK (\"status\" IN ('PENDING', 'ACCEPTED', 'REJECTED'))\n)",
